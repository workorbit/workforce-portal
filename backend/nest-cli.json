{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/auth/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/auth/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/auth",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "employees": {
      "type": "application",
      "root": "apps/employees",
      "entryFile": "main",
      "sourceRoot": "apps/employees/src",
      "compilerOptions": {
        "tsConfigPath": "apps/employees/tsconfig.app.json"
      }
    },
    "timesheets": {
      "type": "application",
      "root": "apps/timesheets",
      "entryFile": "main",
      "sourceRoot": "apps/timesheets/src",
      "compilerOptions": {
        "tsConfigPath": "apps/timesheets/tsconfig.app.json"
      }
    },
    "payroll": {
      "type": "application",
      "root": "apps/payroll",
      "entryFile": "main",
      "sourceRoot": "apps/payroll/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payroll/tsconfig.app.json"
      }
    },
    "feedback": {
      "type": "application",
      "root": "apps/feedback",
      "entryFile": "main",
      "sourceRoot": "apps/feedback/src",
      "compilerOptions": {
        "tsConfigPath": "apps/feedback/tsconfig.app.json"
      }
    },
    "notifications": {
      "type": "application",
      "root": "apps/notifications",
      "entryFile": "main",
      "sourceRoot": "apps/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}
